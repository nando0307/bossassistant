# ==========================================================================
# BossAssistant environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ==========================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Neo4j AuraDB ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# Embeddings and offline graph indexing/evaluation only. Keep the existing vector space.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Online generation: internal multi-agent gateway, NOT the public research endpoint.
# Include /v1. Use private networking or TLS; token equals gateway GATEWAY_SERVICE_TOKEN.
GENERATION_BASE_URL=http://127.0.0.1:8001/v1
GENERATION_API_KEY=replace-with-a-dedicated-service-token
# Gateway owns a 60-second total budget per generation; Boss never retries it.
GENERATION_TIMEOUT_SECONDS=65
GENERATION_MAX_TOKENS=384
ENABLE_RERANKER=false

# --- LangSmith (optional, for tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=bossassistant

# --- Langfuse (optional, for LLM observability) ---
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS (for frontend) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth (JWT-scoped retrieval) ---
# Required when REQUIRE_AUTH=true. Retrieval filters chunks by the token's
# groups claim, so an unset secret with auth on is refused at startup.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=bossassistant
JWT_AUDIENCE=bossassistant-api
REQUIRE_AUTH=true
ENABLE_DEMO_AUTH=false
ENABLE_SEMANTIC_CACHE=true
